% Lampiran: judul "LAMPIRAN 1", "LAMPIRAN 2", ... (pakai \uilampiran, bukan \appendix)
\newcommand{\uilampiran}{%
  % tanpa \clearpage: perintah daftar isi harus ikut halaman sebelumnya
  \setcounter{chapter}{0}\setcounter{section}{0}%
  \renewcommand{\thechapter}{\arabic{chapter}}%
  \renewcommand{\theHchapter}{lampiran.\arabic{chapter}}% tautan unik untuk hyperref
  \titleformat{\chapter}[display]
    {\normalfont\fontsize{12}{14}\selectfont\bfseries\centering\setstretch{1}}
    {LAMPIRAN \thechapter}{0pt}{\MakeUppercase}%
  \addtocontents{toc}{\protect\renewcommand{\protect\cftchappresnum}{LAMPIRAN }%
    \protect\setlength{\protect\cftchapnumwidth}{7em}}%
}

% Baris pembimbing kedua di Halaman Pengesahan (kosong jika \pembimbingdua{} kosong)
\def\@barispembimbingdua{Pembimbing & \@pembimbingdua & (\hspace{3cm}) \\[1cm]}
\newcommand{\barispembimbingdua}{\ifx\@pembimbingdua\@empty\else\@barispembimbingdua\fi}

% Logo UI: letakkan file gambar/logo-ui.pdf atau gambar/logo-ui.png (hitam, diameter 2,5 cm).
\newcommand{\logoui}{%
  \IfFileExists{gambar/logo-ui.pdf}{\includegraphics[width=2.5cm]{gambar/logo-ui.pdf}}{%
  \IfFileExists{gambar/logo-ui.png}{\includegraphics[width=2.5cm]{gambar/logo-ui.png}}{%
  \fbox{\parbox[c][2.5cm][c]{2.5cm}{\centering\scriptsize LOGO UI\\(gambar/logo-ui.png)}}}}}

% Istilah asing dicetak miring: \asing{large language model}
\newcommand{\asing}[1]{\textit{#1}}

% ---------------------------------------------------------------------------
% Referensi: IEEE bernomor (seperti skripsi Ivander, FT UI). Ganti style= jika
% pembimbing/fakultas menetapkan gaya lain (pedoman 10.18: APA, Harvard, dll.).
% ---------------------------------------------------------------------------
% biblatex belum punya bahasa Indonesia: istilah referensi (et al., pp., in) memakai bahasa Inggris.
\RequirePackage[backend=biber,style=ieee,sorting=none]{biblatex}
\DeclareLanguageMapping{indonesian}{english}

% hyperref dimuat terakhir
\RequirePackage[hidelinks,bookmarksnumbered]{hyperref}

