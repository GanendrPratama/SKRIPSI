% ui-thesis.sty — Format Tugas Akhir (monograf) sesuai
% Pedoman Penyelenggaraan Tugas Akhir dan Publikasi Karya Ilmiah UI 2025, bab 10,
% dan Template Tugas Akhir UI 2025.
% Kompilasi: pdfLaTeX + Biber (Overleaf: Menu > Compiler = pdfLaTeX).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ui-thesis}[2026/11/11 Format Tugas Akhir UI 2025]

% ---------------------------------------------------------------------------
% Kertas dan margin (pedoman 10.4, 10.5): A4, 3 cm di keempat sisi.
% Nomor halaman isi: kanan atas, 1,5 cm dari tepi atas (10.6)
%   -> headheight 15pt (~0,53 cm) + headsep 0,97 cm = 1,5 cm di atas teks.
% Nomor halaman romawi: tengah bawah, 2,5 cm dari tepi bawah
%   -> footskip 14,5 pt (~0,51 cm; minimum fancyhdr), nomor ~2,49 cm dari tepi bawah.
% ---------------------------------------------------------------------------
\RequirePackage[a4paper,
  left=3cm,right=3cm,top=3cm,bottom=3cm,
  headheight=15pt,headsep=0.97cm,footskip=14.5pt]{geometry}

% ---------------------------------------------------------------------------
% Huruf: Times New Roman 12 pt (mathptmx = Times), footer Arial -> Helvetica.
% ---------------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{amsmath}
\RequirePackage{mathptmx}% Times untuk teks dan matematika (paket psnfss)
\RequirePackage[indonesian]{babel}
\RequirePackage[autostyle=false,style=english]{csquotes}

% ---------------------------------------------------------------------------
% Spasi: 1,5 (Word "1.5 lines" untuk TNR 12 pt kira-kira setara stretch 1,43),
% rata kiri-kanan (default LaTeX), indentasi baris pertama 1,27 cm.
% ---------------------------------------------------------------------------
\RequirePackage{setspace}
\setstretch{1.43}
\RequirePackage{indentfirst}
\setlength{\parindent}{1.27cm}
\setlength{\parskip}{0pt}

% ---------------------------------------------------------------------------
% Paket umum
% ---------------------------------------------------------------------------
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{multirow}
\RequirePackage{enumitem}
\setlist{nosep}
\RequirePackage{url}
\RequirePackage{microtype}

% ---------------------------------------------------------------------------
% Judul bab dan subbab (pedoman 10.2)
%   - "BAB n" lalu judul, huruf kapital, tebal, tengah, 12 pt, satu spasi.
%   - Subbab maksimal 3 derajat: 1.1, 1.1.1, 1.1.1.1.
% ---------------------------------------------------------------------------
\RequirePackage{titlesec}
\setcounter{secnumdepth}{3}
\setcounter{tocdepth}{2}
\titleformat{\chapter}[display]
  {\normalfont\fontsize{12}{14}\selectfont\bfseries\centering\setstretch{1}}
  {BAB \thechapter}{0pt}{\MakeUppercase}
\titleformat{name=\chapter,numberless}[block]
  {\normalfont\fontsize{12}{14}\selectfont\bfseries\centering\setstretch{1}}
  {}{0pt}{\MakeUppercase}
\titlespacing*{\chapter}{0pt}{0pt}{2\baselineskip}
\titleformat{\section}
  {\normalfont\fontsize{12}{14}\selectfont\bfseries}{\thesection}{1em}{}
\titleformat{\subsection}
  {\normalfont\fontsize{12}{14}\selectfont\bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}
  {\normalfont\fontsize{12}{14}\selectfont\bfseries}{\thesubsubsection}{1em}{}
\titlespacing*{\section}{0pt}{1\baselineskip}{0pt}
\titlespacing*{\subsection}{0pt}{0.5\baselineskip}{0pt}
\titlespacing*{\subsubsection}{0pt}{0.5\baselineskip}{0pt}

% ---------------------------------------------------------------------------
% Keterangan gambar dan tabel: tabel di atas, gambar di bawah, bernomor per bab.
% ---------------------------------------------------------------------------
\RequirePackage{caption}
\captionsetup{font={normalsize,stretch=1},labelsep=period,justification=centering}
\captionsetup[table]{position=top,skip=6pt}
\captionsetup[figure]{position=bottom,skip=6pt}
% Sumber di bawah tabel/gambar: \sumber{Data primer, 2027}
\newcommand{\sumber}[1]{\par\vspace{2pt}{\centering\small\textit{Sumber: #1}\par}}

% ---------------------------------------------------------------------------
% Nama-nama bagian (bahasa Indonesia, huruf kapital)
% ---------------------------------------------------------------------------
\addto\captionsindonesian{%
  \renewcommand{\contentsname}{DAFTAR ISI}%
  \renewcommand{\listfigurename}{DAFTAR GAMBAR}%
  \renewcommand{\listtablename}{DAFTAR TABEL}%
  \renewcommand{\figurename}{Gambar}%
  \renewcommand{\tablename}{Tabel}%
  \renewcommand{\appendixname}{Lampiran}%
  \renewcommand{\bibname}{DAFTAR REFERENSI}%
}

% ---------------------------------------------------------------------------
% Daftar isi (pedoman 10.15): satu spasi, judul bab tebal kapital.
% Tulis judul bab dengan huruf kapital: \chapter{PENDAHULUAN}.
% ---------------------------------------------------------------------------
\RequirePackage[titles]{tocloft}
\renewcommand{\cftchappresnum}{BAB }
\setlength{\cftchapnumwidth}{4em}
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftchappagefont}{\bfseries}
\renewcommand{\cftchapleader}{\cftdotfill{\cftdotsep}}
\renewcommand{\cftfigpresnum}{Gambar }
\renewcommand{\cfttabpresnum}{Tabel }
\setlength{\cftfignumwidth}{5.5em}
\setlength{\cfttabnumwidth}{5em}
\setlength{\cftbeforechapskip}{4pt}

% ---------------------------------------------------------------------------
% Header dan footer (pedoman 10.5, 10.6)
%   - Footer "Universitas Indonesia" (Arial 10 pt tebal, rata kanan) di setiap
%     halaman mulai Abstrak sampai Daftar Referensi.
%   - Bagian awal: angka romawi kecil, tengah bawah.
%   - Isi: angka arab, kanan atas.
% ---------------------------------------------------------------------------
\RequirePackage{fancyhdr}
\newcommand{\uifootertext}{%
  {\fontfamily{phv}\fontsize{10}{12}\selectfont\bfseries Universitas Indonesia}}
\fancypagestyle{uifrontplain}{% sebelum Abstrak: romawi, tanpa footer UI
  \fancyhf{}\fancyfoot[C]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{uifront}{% Abstrak s.d. Daftar Tabel: romawi + footer UI
  \fancyhf{}\fancyfoot[C]{\thepage}\fancyfoot[R]{\uifootertext}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}
\fancypagestyle{uibody}{% isi: arab kanan atas + footer UI
  \fancyhf{}\fancyhead[R]{\thepage}\fancyfoot[R]{\uifootertext}%
  \renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}

% \chapter memakai gaya "plain"; perintah di bawah menyamakannya dengan gaya aktif.
\newcommand{\uifrontmatterplain}{%
  \pagestyle{uifrontplain}%
  \fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}%
    \renewcommand{\headrulewidth}{0pt}}}
\newcommand{\uifrontmatter}{%
  \pagestyle{uifront}%
  \fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\fancyfoot[R]{\uifootertext}%
    \renewcommand{\headrulewidth}{0pt}}}
\newcommand{\uimainmatter}{%
  \clearpage\pagenumbering{arabic}\pagestyle{uibody}%
  \fancypagestyle{plain}{\fancyhf{}\fancyhead[R]{\thepage}\fancyfoot[R]{\uifootertext}%
    \renewcommand{\headrulewidth}{0pt}}}

