  title = {{{LLM-Based Intelligent Agents}} for {{Cybersecurity}}: {{A Tutorial}} and {{Survey}} of {{Automated Vulnerability Discovery}}},
  shorttitle = {{{LLM-Based Intelligent Agents}} for {{Cybersecurity}}},
  author = {Addis, Robel and Porter, Kiran and Ryan, Jayden and Stull, Micah and Xu, Shengjie and Wagner, Paul and Honomichl, Robert and Forsyth, Steven},
  date = {2026},
  journaltitle = {IEEE Access},
  shortjournal = {IEEE Access},
  volume = {14},
  pages = {100884--100917},
  issn = {2169-3536},
  doi = {10.1109/ACCESS.2026.3707573},
  url = {https://ieeexplore.ieee.org/document/11580353/},
  urldate = {2026-11-11},
  abstract = {This paper provides a tutorial and survey of LLM-based agents for automated vulnerability discovery and penetration testing. The rapid advancements in Large Language Models (LLMs) have opened new possibilities for their application in cybersecurity. Unlike traditional tools, LLMs can process natural language, retain context, and perform structured reasoning, enabling automation of complex security workflows. By equipping these models with memory mechanisms and tool-use interfaces, researchers have developed LLM-driven autonomous agents capable of performing specialized tasks such as web application testing, source code auditing, fuzzing, and network security assessment. Multi-agent architectures have emerged in which agents assume specialized roles (e.g., distinct penetration-test phases or exploit types). In addition to surveying existing applications, this work provides a step-by-step walkthrough of integrating agentic AI into penetration testing workflows. The walkthrough explores four phases: (I) mission scoping and prompt engineering for test definition and constraint enforcement, (II) autonomous exploration and tool selection for target interaction, (III) vulnerability hypothesis formation and verification through experiment design and feedback, and (IV) payload generation and refinement to transform validated findings into concrete exploits. The survey synthesizes 155 cited sources (2022–early 2026) using explicit inclusion/exclusion criteria, with coverage extending to reasoning-class models, the Model Context Protocol ecosystem, autonomous bug-bounty agents, and standardized agentic security benchmarks. Despite progress, challenges persist, such as model hallucination, context limitations, operating costs, and ethical concerns. Future directions include advancements in multi-agent collaboration, mechanisms for agent selfimprovement, and improved transparency into agent behavior.},
  langid = {english},
  file = {/home/ganendr/Zotero/storage/ZI6FNFZG/Addis et al. - 2026 - LLM-Based Intelligent Agents for Cybersecurity A Tutorial and Survey of Automated Vulnerability Dis.pdf}
}

@article{aliDoubleedgedSwordLLM2026,
  title = {The Double-Edged Sword: {{LLM}} Operations ({{LLMOps}}) Security in the Cloud- a Comprehensive Review},
  shorttitle = {The Double-Edged Sword},
  author = {Ali, Sijjad and Talpur, Dhani Bux and Humayun, Mamoona and Almufareh, Maraam Fahaad and Alwakid, Ghadah Naif and Yaqoob, Jahanzaib},
  date = {2026-06},
  journaltitle = {Neurocomputing},
  shortjournal = {Neurocomputing},
  volume = {680},
  pages = {133313},
  issn = {09252312},
  doi = {10.1016/j.neucom.2026.133313},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0925231226007101},
  urldate = {2026-11-11},
  abstract = {The rapid integration of Large Language Models (LLMs) into enterprise applications via cloud platforms has necessitated the emergence of LLM Operations (LLMOps)—a specialized discipline for managing the LLM lifecy cle. While LLMOps streamlines development and maintenance, it introduces a complex and novel attack surface that traditional cybersecurity frameworks face significant challenges in addressing. This review paper provides a comprehensive analysis of the double-edged sword of LLMOps security within cloud environments. We systemati cally examine the LLMOps lifecycle to expose critical vulnerabilities, beginning at the API layer with sophisticated prompt injection and jailbreaking techniques that subvert model behavior. The analysis extends to the core in frastructure, examining the security of vector databases—a prime target for data exfiltration or poisoning—and the integrity of the retrieval-augmented generation (RAG) pipeline. Furthermore, we investigate the significant privacy and security risks associated with the fine-tuning phase in the cloud, where proprietary data used for adap tation becomes vulnerable to exposure or inference attacks. This paper argues that the interconnected nature of cloud-based LLMOps amplifies these threats, creating cascading risks across the entire system. By synthesizing current research and emerging threats, this review aims to establish a foundational security taxonomy for LLMOps and proposes a proactive, defense-in-depth strategy essential for securing the next generation of AI-driven appli cations in the cloud. The findings underscore an urgent need for robust security paradigms blueconstructed into the fabric of LLMOps practices.},
  langid = {english},
  file = {/home/ganendr/Zotero/storage/24N27QB3/Ali et al. - 2026 - The double-edged sword LLM operations (LLMOps) security in the cloud- a comprehensive review.pdf}
}

@article{altharAutomatedRiskManagement2022,
