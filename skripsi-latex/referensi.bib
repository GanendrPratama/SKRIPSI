  keywords = {Computer Science - Artificial Intelligence,Computer Science - Cryptography and Security},
  file = {/home/ganendr/Zotero/storage/SXXMQXDK/Zhu et al. - 2025 - CVE-Bench A Benchmark for AI Agents' Ability to Exploit Real-World Web Application Vulnerabilities.pdf}
