  url = {https://linkinghub.elsevier.com/retrieve/pii/S2667305326000566},
  urldate = {2026-11-11},
  abstract = {Penetration Testing (PT), also referred to as Ethical Hacking, is a fundamental practice in Cybersecurity that involves evaluating the security of systems, networks, and applications to identify vulnerabilities and potential attacks. Traditional approaches to Penetration Testing are often time-consuming, relying on manual processes, and requiring advanced expertise due to the technical complexity of Penetration Testing tools. In this paper, a Retrieval-Augmented Generation (RAG) pipeline that enhances a trained Large Language Model (LLM) was developed to serve as an intelligent Pentest Assistant. It is designed to assist users throughout the Penetration Testing workflow, ranging from vulnerability assessment to remediation, by providing contextual guidance, command suggestions, and technical explanations in natural language. After implementing the proposed architecture, the integration of the RAG pipeline with LLMs demonstrably enhanced response accuracy, contextual relevance, and domain alignment across Penetration Testing tasks. Additionally, a systematic benchmarking study is conducted across seven open-source LLMs under multiple Knowledge Base configurations to assess their effectiveness in supporting PT workflows. The benchmarking results reveal notable performance differences among the evaluated models. Llama 3.1, Llama 3.2, Mistral, and Falcon 3 consistently produced well-structured, step-by-step responses with strong technical depth and command-level guidance, while Gemma 3 and Command R generated coherent but less detailed outputs. DeepSeek, despite fewer safety restrictions, failed to produce actionable PT guidance. To further validate these findings, the evaluated models were assessed against three established Cybersecurity benchmarks (AttackSeqBench, CyberMetric, and Cybench) confirming that Mistral Small 3.1 and Falcon 3 achieve the highest accuracy on knowledge-based tasks, while all models struggle with interactive, flag- capture (CTF) scenarios. Overall, the results demonstrate that combining carefully engineered prompts with RAG-augmented retrieval enables open-source LLMs to produce focused, domain-relevant responses across diverse Penetration Testing scenarios.},
  langid = {english},
  file = {/home/ganendr/Zotero/storage/A9JXBBZV/Fadhel et al. - 2026 - RAG-Augmented LLMs for Penetration Testing A benchmarking study of open-source LLM models.pdf}
