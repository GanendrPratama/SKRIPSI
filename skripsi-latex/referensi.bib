  urldate = {2026-11-11},
  abstract = {Large Language Models excel at complex reasoning but suffer from single-agent limitations such as fixed reasoning patterns and hallucinations. While multi-agent debate frameworks can mitigate these issues through collaboration, existing approaches either employ homogeneous reasoning strategies or lack structured cross-agent coordination. We propose G-DMAD, a group-based debate framework that partitions agents into distinct groups, each employing a different reasoning strategy (e.g., Input-Output, Chain-of-Thought, Duty-Distinct CoT). Through intra-group iterative refinement and inter-group leader selection via a meta-evaluator LLM, G-DMAD enables broader exploration of reasoning paths while maintaining solution convergence. Extensive experiments on the MM-Vet and ScienceQA benchmarks demonstrate that G-DMAD achieves state-of-the-art results across diverse model families, reaching 73.07\% accuracy on GPT-5-nano and 73.35\% on GLM-4.1V-Thinking-Flash. Notably, G-DMAD delivers a significant performance leap of +8.53\% on GPT-5-nano with only a marginal 5\% increase in token consumption (3.73M → 3.92M), effectively bridging the performance gap between disparate model scales while maintaining high computational efficiency. The robust improvements in both accuracy and F1 scores on scientific reasoning tasks further underscore G-DMAD’s superior generalizability and its ability to mitigate ‘‘cognitive fixation’’ in complex multimodal environments.},
  langid = {english},
  file = {/home/ganendr/Zotero/storage/YI75PBRW/Chen et al. - 2026 - G-DMAD Group-Based Diverse Multi-Agent Debate for Robust Reasoning.pdf}
}

@article{chenSurveyLargeLanguage2024,
  title = {A Survey of Large Language Models for Cyber Threat Detection},
