  urldate = {2026-11-11},
  abstract = {The execution of Large Language Models (LLMs) on GPUs has been shown to exhibit nondeterministic behavior, even under deterministic settings, due to finite-precision arithmetic and the order of parallel operations. This poses challenges for deploying LLMs in dependable systems, because the lack of consistency represents a fundamental reliability issue that complicates for example the auditability and certification of LLM decision-making. Previous studies mainly focus on output variability or enforcing deterministic execution. To enable a deeper analysis, this work investigates the nondeterminism at the token probability level. Through extensive evaluations across multiple LLMs, GPU platforms, and configurations, consistent results in both the trends and quantitative variations of probabilities are observed: nondeterminism significantly affects token probabilities in the range of 0.1 to 0.9, while probabilities near 0 or 1 remain relatively stable. Based on the findings, significant implications and insights for understanding nondeterminism in LLMs are provided in this paper. i) Nondeterminism can meaningfully affect the generated text when the temperature is not zero by perturbing mid-range token probabilities; ii) its impact depends on model characteristics such as probability distributions and output length; iii) the effect of nondeterminism may potentially be estimated using a single inference by analyzing token-level probabilities, without requiring repeated runs. Finally, the data and code produced in this work is released publicly to facilitate further investigation.},
  langid = {english},
  file = {/home/ganendr/Zotero/storage/IHVACAC4/Fu et al. - 2026 - Beyond Reproducibility Token Probabilities Expose Large Language Model Nondeterminism.pdf}
