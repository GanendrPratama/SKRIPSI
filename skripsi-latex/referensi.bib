  title = {When Does Relational Calibration Help an {{LLM}}-as-a-Judge? {{A}} Human-Grounded, Strict-Inductive Study of Value Calibration and Selection},
  shorttitle = {When Does Relational Calibration Help an {{LLM}}-as-a-Judge?},
  author = {Zhang, Yunan and Fan, Jingjing and Liu, Yanxiao},
  date = {2027-03},
